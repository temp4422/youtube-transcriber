---
export const prerender = true;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Turn YouTube captions into readable, copyable text." />
    <title>YouTube Transcriber</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%232d5b48'/%3E%3Cpath d='M12 9l12 7-12 7z' fill='white'/%3E%3C/svg%3E" />
  </head>
  <body>
    <main>
      <h1>YouTube Transcriber</h1>
      <p class="description">Paste a video link to get its captions as text.</p>
      <form id="transcribe-form">
        <label for="video-url">YouTube video link</label>
        <div class="input-row">
          <input id="video-url" name="url" type="url" required maxlength="2048" placeholder="https://www.youtube.com/watch?v=…" autocomplete="off" spellcheck="false" aria-describedby="input-help" />
          <button id="transcribe-button" class="primary" type="submit"><span id="button-label">Transcribe</span></button>
        </div>
        <p id="input-help" class="help">Language is selected automatically. You can change it below.</p>
        <div id="language-container" hidden>
          <label for="language">Caption language</label>
          <select id="language" name="languageCode"><option value="">Automatic</option></select>
        </div>
        <p id="status" class="status" role="status" aria-live="polite" hidden></p>
      </form>
      <section id="result" aria-labelledby="transcript-title" aria-busy="false" hidden>
        <div class="result-header">
          <div><h2 id="transcript-title">Transcript</h2><p id="result-detail"></p></div>
          <div class="result-actions">
            <button id="copy-button" class="secondary" type="button" disabled><span id="copy-label">Copy text</span></button>
            <button id="download-button" class="secondary" type="button" disabled>Download .txt</button>
          </div>
        </div>
        <textarea id="transcript" readonly aria-label="Transcript text" spellcheck="false" hidden></textarea>
        <p id="copy-status" class="copy-status" role="status" aria-live="polite"></p>
      </section>
      <footer>Uses existing YouTube captions. No sign-in or saved history.</footer>
    </main>
    <script>import '../scripts/transcriber.ts';</script>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box}
  :global([hidden]){display:none!important}
  :global(body){margin:0;background:#f8faf8;color:#26372e;font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased}
  :global(button),:global(input),:global(select),:global(textarea){font:inherit}
  :global(:focus-visible){outline:3px solid #527b65;outline-offset:3px}
  main{max-width:800px;margin:0 auto;padding:64px 24px 24px}
  h1{font-size:28px;letter-spacing:-.7px;margin:0 0 10px}
  .description{color:#59685e;font-size:15px;line-height:1.6;margin:0 0 32px}
  label{display:block;font-size:13px;font-weight:600;margin-bottom:9px}
  .input-row{display:flex;gap:10px}
  input,select{border:1px solid #cbd5cd;border-radius:7px;background:#fff;color:#26372e;padding:13px;font-size:15px}
  input{min-width:0;flex:1}input::placeholder{color:#748077}
  button{cursor:pointer;border-radius:7px;padding:12px 18px;font-size:14px;font-weight:600;min-height:44px}
  button:disabled{cursor:default;opacity:.65}
  .primary{background:#2d5b48;border:1px solid #2d5b48;color:white}
  .primary:not(:disabled):hover{background:#244b3b}
  .help,footer{font-size:12px;line-height:1.6;color:#617067}
  .help{margin:10px 0 0}
  #language-container{margin-top:20px}select{width:100%;max-width:320px}
  .status{font-size:14px;line-height:1.5;margin:16px 0 0;color:#395b44}
  .status.error{color:#963f2d}
  #result{margin-top:28px;background:#fff;border:1px solid #d6ded7;border-radius:10px;overflow:hidden}
  .result-header{padding:16px 20px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;border-bottom:1px solid #e5eae6}
  .result-actions{display:flex;flex-wrap:wrap;gap:8px}
  h2{font-size:16px;margin:0 0 5px}.result-header p{font-size:12px;color:#617067;margin:0}
  .secondary{background:#fff;border:1px solid #cbd5cd;color:#36543e;white-space:nowrap}.secondary:hover{background:#f0f4ec}
  textarea{display:block;width:100%;min-height:300px;height:55vh;resize:vertical;padding:20px;border:0;line-height:1.8;font-size:15px;color:#26372e;background:white}
  textarea:focus-visible{outline-offset:-3px}
  .copy-status{font-size:12px;color:#395b44;margin:0;padding:0 20px}.copy-status:not(:empty){padding-bottom:16px}
  footer{margin-top:24px}
  @media(max-width:600px){main{padding:32px 16px 20px}h1{font-size:25px}.input-row{flex-direction:column}input,select,textarea{font-size:16px}.primary{width:100%}.result-header{padding:16px}textarea{padding:16px}}
</style>
