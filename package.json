{
  "name": "youtube-transcriber",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "astro dev --host 127.0.0.1 --port 3000",
    "check": "astro check",
    "build": "astro build",
    "start": "HOST=127.0.0.1 PORT=3000 node dist/server/entry.mjs",
    "probe": "node scripts/backend-probe.ts",
    "probe:backend": "node scripts/backend-probe.ts",
    "test:browser": "node --test tests/browser/*.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "astro": "7.4.5",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "26.6.6",
    "typescript": "6.0.3"
  }
}
